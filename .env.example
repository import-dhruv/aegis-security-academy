# AEGIS Academy — example environment (NO REAL SECRETS)
# Copy to .env and replace placeholders. Never commit .env.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
RATE_LIMIT_PER_MINUTE=60

# --- Persistence -----------------------------------------------------------
# Leave unset for the local SQLite fallback (./backend/aegis.db).
# DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis
# REDIS_URL=redis://redis:6379/0

# --- Security (CHANGE THESE) -----------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-before-deploying-000000
CORS_ORIGINS=http://localhost:3000

# --- Postgres (compose) ----------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# --- AI tutor (all optional; offline scaffold otherwise) -------------------
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# OPENAI_API_KEY=replace-with-a-real-key
TUTOR_MODEL=gpt-4o-mini

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
